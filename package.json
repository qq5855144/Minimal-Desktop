{
  "name": "minimal-desktop",
  "version": "1.2.23",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ext": "vite build --config vite.config.extension.ts",
    "pack:crx": "node scripts/crx3.mjs pack",
    "verify:crx": "node scripts/crx3.mjs verify",
    "typecheck": "tsgo -p tsconfig.check.json",
    "test": "vitest run",
    "lint": "biome lint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:ext"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.576.0",
    "lunar-javascript": "^1.7.7",
    "next-themes": "^0.4.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet-async": "^2.0.5",
    "react-router": "^7.9.5",
    "react-router-dom": "^7.9.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-intersect": "^2.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/chrome": "^0.2.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.11",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.10"
  }
}
